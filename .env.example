# ============================================================
# MidnightRender — Environment Variables Template
# ============================================================
# Copy this file to `.env` in the project root and fill in values.
# `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# ============================================================

# --- Google Gemini / Veo AI Video Generation ---
# Used by services/videoService.ts for AI video generation features.
# Get a free key at: https://aistudio.google.com/apikey
# Optional: the site runs without this, but the AI generation feature won't work.
GEMINI_API_KEY=

# ============================================================
# OPTIONAL — Only needed if you re-host videos on your own
# Cloudflare Stream account. The site itself does NOT read these
# at runtime; videos are referenced by ID in constants.tsx and
# components/AllWorks.tsx. These are listed here so you know what
# to ask for if you need to manage Cloudflare Stream directly.
# ============================================================

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_TOKEN=
# CLOUDFLARE_CUSTOMER_SUBDOMAIN=customer-xxxxxxxxxxxx

# ============================================================
# OPTIONAL — Vercel deploy (managed via Vercel dashboard, not env)
# No env vars are needed for the production deploy unless you
# want the GEMINI_API_KEY available in production. If so, add it
# in the Vercel project settings → Environment Variables.
# ============================================================
